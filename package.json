{
  "name": "kokosa-forward",
  "version": "1.0.0",
  "type": "module",
  "description": "Telegram message forwarding bot with AI content moderation",
  "main": "src/index.ts",
  "scripts": {
    "deploy": "node ./node_modules/wrangler/bin/wrangler.js deploy",
    "dev": "node ./node_modules/wrangler/bin/wrangler.js dev",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "telegram",
    "bot",
    "cloudflare-workers"
  ],
  "author": "hatanokokosa",
  "license": "BSD-2-Clause",
  "packageManager": "bun@1.3.11",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260410.0",
    "globals": "^16.5.0",
    "prettier": "3.7.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.55.0"
  }
}
